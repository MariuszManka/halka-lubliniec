{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "cms:dev": "sanity dev",
    "cms:build": "sanity build sanity-dist",
    "cms:deploy": "sanity deploy",
    "cms:seed": "sanity exec scripts/seed-sanity.mjs --with-user-token",
    "deploy": "node scripts/deploy-site.mjs",
    "deploy:preview": "node scripts/deploy-site.mjs --target=preview",
    "deploy:production": "node scripts/deploy-site.mjs --target=production",
    "gallery:sync": "node scripts/sync-gallery.mjs",
    "session:sync": "node scripts/sync-session.mjs",
    "home:images": "node scripts/generate-home-images.mjs",
    "session:prune": "node scripts/prune-session.mjs",
    "media:sync": "npm run gallery:sync && npm run session:sync && npm run home:images",
    "prebuild": "npm run media:sync",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "drizzle-orm": "0.45.2",
    "motion": "^12.43.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-icons": "^5.7.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@sanity/vision": "^6.11.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "cross-env": "^10.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "sanity": "^6.11.0",
    "styled-components": "^6.5.3",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
